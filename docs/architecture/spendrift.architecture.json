  "cards": [
    {
      "dot": "cyan",
      "title": "One gated capture pipeline",
      "items": [
        "Voice, receipt, statement and SMS capture share the same shape: gate, parse on the backend, insert into the ledger",
        "AI keys never ship in the app; only a client token reaches the /v1 backend"
      ]
    },
    {
      "dot": "violet",
      "title": "App Group is the seam",
      "items": [
        "Four processes (app, widgets, intents, share extension) share one SwiftData ledger",
        "Quota counters and pending imports live in the shared defaults suite, not UserDefaults.standard"
      ]
    },
    {
      "dot": "amber",
      "title": "Facades keep vendors out of features",
      "items": [
        "Analytics wraps PostHog, Diagnostics wraps Sentry, PushNotifications wraps OneSignal",
        "Pro state is read via ProGate so feature code never touches StoreKit"
      ]
    }
  ]
}