        "id": "capture-path",
        "label": "AI capture path",
        "focus": [
          "shell",
          "pipelines",
          "progate",
          "client",
          "api",
          "store"
        ],
        "note": "Voice, receipt, statement and SMS capture all flow through one gated pipeline to the backend and into the ledger."
      },
      {
        "id": "entry-surfaces",
        "label": "Entry surfaces",
        "focus": [
          "widgets",
          "intents",
          "shareext",
          "store",
          "shell"
        ],
        "note": "Widgets, Shortcuts and the Share Extension run as separate processes and meet the app through the App Group."
      },
      {
        "id": "monetization",
        "label": "Pro and quota",
        "focus": [
          "pipelines",
          "progate",
          "appstore",
          "notifications"
        ],
        "note": "StoreKit 2 entitlement plus per-feature monthly credits decide whether an AI parse may run."
      },
      {
        "id": "telemetry",
        "label": "Telemetry and push",
        "focus": [
          "shell",
          "observability",
          "api",
          "notifications",
          "onesignal"
        ],
        "note": "PostHog and Sentry are reached through the backend host; OneSignal handles remote push and audience tags."
      }
    ]
