<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ronakpunase.Spendrift</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>spendrift</string>
			</array>
		</dict>
	</array>
	<key>SpendriftBackendBaseURL</key>
	<string>$(SPENDRIFT_BACKEND_BASE_URL)</string>
	<key>SpendriftBackendClientToken</key>
	<string>$(SPENDRIFT_BACKEND_CLIENT_TOKEN)</string>
	<key>SpendriftPostHogAPIKey</key>
	<string>$(SPENDRIFT_POSTHOG_API_KEY)</string>
	<key>SpendriftPostHogHost</key>
	<string>$(SPENDRIFT_POSTHOG_HOST)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
